{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyedx.local/schemas/image-quality.schema.json",
  "title": "Image quality record",
  "description": "Structural (non-clinical) quality signals for a single image, produced by the image validator. These are screening data-quality indicators only and never constitute a diagnosis.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "readable"],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "description": "Manifest record identifier (not a patient identifier)."
    },
    "readable": {
      "type": "boolean",
      "description": "Whether the image decoded successfully."
    },
    "format": {
      "type": ["string", "null"],
      "description": "Detected image format (e.g. JPEG, PNG)."
    },
    "mode": {
      "type": ["string", "null"],
      "description": "Detected colour mode (e.g. RGB, L)."
    },
    "width": {"type": ["integer", "null"], "minimum": 0},
    "height": {"type": ["integer", "null"], "minimum": 0},
    "brightness": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Mean luminance in [0,1]; a structural signal, not a clinical measure."
    },
    "blur_score": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Heuristic blur score (higher is blurrier)."
    },
    "issues": {
      "type": "array",
      "description": "Issue codes raised by the validator for this image.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "warning", "error"]},
          "message": {"type": "string"}
        }
      }
    }
  }
}
