# EyeDx backend environment variables.
#
# Copy to `.env` for local development. Never commit real secrets.
# Values shown as <...> are REQUIRED and must be provided per environment.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=eyedx-backend
APP_ENV=development            # development | staging | production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                 # true in production

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------
# Standard PostgreSQL URL; the driver is normalised to asyncpg automatically.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------------------------------------------------------------------------
# Authentication (REQUIRED in production)
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<strong-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=14

# ---------------------------------------------------------------------------
# CORS (comma-separated origins; empty disables CORS middleware)
# ---------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ---------------------------------------------------------------------------
# Request limits / rate limiting
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=20
REQUEST_TIMEOUT_SECONDS=60
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Model service
# ---------------------------------------------------------------------------
# Required unless INFERENCE_MOCK_MODE=true in a non-production environment.
MODEL_SERVICE_URL=
MODEL_SERVICE_TIMEOUT_SECONDS=30
INFERENCE_MOCK_MODE=true

# ---------------------------------------------------------------------------
# Feature flags (default off)
# ---------------------------------------------------------------------------
FEATURE_EXPLAINABILITY=false
FEATURE_UNCERTAINTY=false
FEATURE_ABSTENTION=false
CONSENT_REQUIRED=true

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_PATH=./var/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
