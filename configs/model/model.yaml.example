# Model config
# Status: INPUT_REQUIRED - real model paths/artifacts from approved source

model:
  id: "eyedx-screening"
  version: "1.0.0"  # must match registry
  path: null  # INPUT_REQUIRED: absolute path or registry reference
  device: "cpu"
  batch_size: 1
  timeout_seconds: 30

preprocessing:
  input_size: [224, 224]
  mean: [0.485, 0.456, 0.406]  # INPUT_REQUIRED if using specific preprocessing
  std: [0.229, 0.224, 0.225]

quality:
  enabled: true
  thresholds: {}  # INPUT_REQUIRED per model

uncertainty:
  enabled: true
  method: "max_prob"
  threshold: 0.6  # INPUT_REQUIRED (approval needed)

abstention:
  enabled: true
  threshold: 0.5  # INPUT_REQUIRED (approval needed)

explanation:
  enabled: false
  method: "none"
