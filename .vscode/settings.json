{
  // Python General Settings
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.autoImportCompletions": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },
  // Ruff Linter Configuration
  "ruff.lint.args": [
    "--config=${workspaceFolder}/backend/pyproject.toml"
  ],
  // TypeScript / React Settings
  "[typescript][typescriptreact][javascript][javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  // JSON/YAML Validation
  "[json][jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // File Exclusions for Medical AI Project
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/node_modules": true,
    "**/.vite": true,
    "**/wandb": true,
    "**/*.pt": true,
    "**/*.pth": true,
    "**/*.onnx": true,
    "**/datasets/**": true,
    "**/checkpoints/**": true
  },
  // Search Exclusions (Performance)
  "search.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/dist": true,
    "**/build": true,
    "**/*.pt": true,
    "**/*.pth": true,
    "**/datasets": true
  },
  // Terminal Environment
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/model-service"
  },
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}/backend:${workspaceFolder}/model-service"
  },
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}/backend;${workspaceFolder}/model-service"
  }
}
